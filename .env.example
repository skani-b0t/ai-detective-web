# ===== 元宝搜索查证工具 环境变量示例 =====
# 复制本文件为 .env 后填写

# 运行模式：offline 用预置样例（无需Key，适合先跑通）；live 调真实API
WSA_MODE=offline

# 腾讯云密钥（WSA_MODE=live 时必填），在腾讯云控制台「访问管理→API密钥」获取
WSA_SECRET_ID=
WSA_SECRET_KEY=

# 单次查证返回结果条数（10/20/30/40/50）
WSA_MAX_RESULTS=10

# 断言抽取用的混元模型（TokenHub 平台）；常见 hy3 / hy3-preview，以控制台在线推理服务列表为准
HUNYUAN_MODEL=hy3

# TokenHub API Key（调用混元 hy3-preview 抽取断言用）。
# 注意：这是 TokenHub 控制台单独创建的 Key，不是腾讯云 SecretId/SecretKey。
# 获取：https://console.cloud.tencent.com/tokenhub/apikey
# 留空则自动回退「启发式规则」抽取（不影响主流程）。
TOKENHUB_API_KEY=
